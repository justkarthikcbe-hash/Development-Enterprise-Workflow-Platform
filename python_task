factorial = 1
for i in range(1, num + 1):
    factorial *= i
print("Factorial:", factorial)

# 23. Fibonacci Series
print("\n23. FIBONACCI SERIES")
a, b = 0, 1
for i in range(10):
    print(a, end=" ")
    a, b = b, a + b
print()

# 24. Reverse a Number
print("\n24. REVERSE A NUMBER")
num = 12345
reverse = int(str(num)[::-1])
print("Reverse:", reverse)

# 25. Prime Number
print("\n25. PRIME NUMBER")
num = 17
if num > 1:
    for i in range(2, int(num ** 0.5) + 1):
        if num % i == 0:
            print("Not Prime")
            break
    else:
        print("Prime Number")
else:
    print("Not Prime")

# 26. Reverse a String
print("\n26. REVERSE STRING")
text = "Python Programming"
print("Reversed:", text[::-1])

# 27. Palindrome
print("\n27. PALINDROME")
text = "madam"
if text == text[::-1]:
    print("Palindrome")
else:
    print("Not Palindrome")

# 28. Count Vowels
print("\n28. COUNT VOWELS")
text = "Python Programming"
count = 0
for ch in text.lower():
    if ch in "aeiou":
        count += 1
print("Vowel Count:", count)

